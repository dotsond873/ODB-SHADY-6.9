# Groq Cloud (OpenAI-compatible Chat Completions API).
# Set the real API key and owner token privately in your runtime environment.
# Never commit real API keys or put them in task arguments.
SHADY_PROVIDER_NAME=groq
SHADY_API_BASE_URL=https://api.groq.com/openai/v1
SHADY_MODEL=openai/gpt-oss-120b
SHADY_API_KEY=
SHADY_TIMEOUT_SECONDS=45
SHADY_ACCESS_TOKEN=
PORT=8000
